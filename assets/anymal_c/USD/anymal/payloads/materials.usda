#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    upAxis = "Z"
)

def Scope "Materials"
{
    def Material "orange"
    {
        color3f inputs:diffuseColor = (0, 0, 0)
        float inputs:metallic = 0
        float inputs:opacity = 0
        float inputs:roughness = 0.5
        token inputs:wrapMode = "repeat"
        token outputs:displacement (
            displayGroup = "Outputs"
        )
        prepend token outputs:displacement.connect = </Materials/orange/PreviewSurface.outputs:displacement>
        token outputs:surface (
            displayGroup = "Outputs"
        )
        prepend token outputs:surface.connect = </Materials/orange/PreviewSurface.outputs:surface>
        token outputs:volume (
            displayGroup = "Outputs"
        )

        def Shader "PreviewSurface" (
            apiSchemas = ["NodeDefAPI"]
        )
        {
            token info:id = "UsdPreviewSurface"
            prepend color3f inputs:diffuseColor.connect = </Materials/orange.inputs:diffuseColor>
            prepend float inputs:metallic.connect = </Materials/orange.inputs:metallic>
            prepend float inputs:opacity.connect = </Materials/orange.inputs:opacity>
            prepend float inputs:roughness.connect = </Materials/orange.inputs:roughness>
            token outputs:displacement
            token outputs:surface
        }
    }

    def Material "base"
    {
        asset inputs:DiffuseTexture = @../Textures/base.jpg@
        float inputs:metallic = 0
        float inputs:opacity = 1
        float inputs:roughness = 0.5
        token inputs:wrapMode = "repeat"
        token outputs:displacement (
            displayGroup = "Outputs"
        )
        prepend token outputs:displacement.connect = </Materials/base/PreviewSurface.outputs:displacement>
        token outputs:surface (
            displayGroup = "Outputs"
        )
        prepend token outputs:surface.connect = </Materials/base/PreviewSurface.outputs:surface>
        token outputs:volume (
            displayGroup = "Outputs"
        )

        def Shader "PreviewSurface" (
            apiSchemas = ["NodeDefAPI"]
        )
        {
            token info:id = "UsdPreviewSurface"
            prepend color3f inputs:diffuseColor.connect = </Materials/base/DiffuseTexture.outputs:rgb>
            prepend float inputs:metallic.connect = </Materials/base.inputs:metallic>
            prepend float inputs:opacity.connect = </Materials/base.inputs:opacity>
            prepend float inputs:roughness.connect = </Materials/base.inputs:roughness>
            token outputs:displacement
            token outputs:surface
        }

        def Shader "DiffuseTexture" (
            apiSchemas = ["NodeDefAPI"]
        )
        {
            token info:id = "UsdUVTexture"
            float4 inputs:fallback = (1, 1, 1, 1)
            prepend asset inputs:file.connect = </Materials/base.inputs:DiffuseTexture>
            token inputs:sourceColorSpace = "auto"
            prepend float2 inputs:st.connect = </Materials/base/Primvar_st_float2.outputs:result>
            token inputs:wrapS = "repeat"
            prepend token inputs:wrapS.connect = </Materials/base.inputs:wrapMode>
            token inputs:wrapT = "repeat"
            prepend token inputs:wrapT.connect = </Materials/base.inputs:wrapMode>
            float3 outputs:rgb
        }

        def Shader "Primvar_st_float2" (
            apiSchemas = ["NodeDefAPI"]
        )
        {
            token info:id = "UsdPrimvarReader_float2"
            string inputs:varname = "st"
            float2 outputs:result
        }
    }

