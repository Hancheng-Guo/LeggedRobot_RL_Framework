{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Test: Core + MuJoCo",
            "type": "process",
            "command": "${command:python.interpreterPath}",
            "args": [
                "-m",
                "pytest",
                "-m",
                "core or mujoco",
                "tests"
            ],
            "group": "test",
            "problemMatcher": [],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "windows": {
                "type": "shell",
                "command": "&",
                "args": [
                    "${command:python.interpreterPath}",
                    "-m",
                    "pytest",
                    "-m",
                    "core or mujoco",
                    "tests"
                ],
                "options": {
                    "cwd": "${workspaceFolder}",
                    "shell": {
                        "executable": "powershell.exe",
                        "args": [
                            "-NoProfile",
                            "-Command"
                        ]
                    }
                }
            }
        },
        {
