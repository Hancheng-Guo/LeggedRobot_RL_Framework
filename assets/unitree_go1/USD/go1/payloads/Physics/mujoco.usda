        def MjcActuator "FR_hip_joint_actuator"
        {
            uniform double[] mjc:biasPrm = [0, -1.7453292608261108, -0.03490658476948738, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:biasType = "affine"
            uniform double mjc:forceRange:max = 23.700000762939453
            uniform double mjc:forceRange:min = -23.700000762939453
            uniform double[] mjc:gainPrm = [1.7453292608261108, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:gainType = "fixed"
            custom rel mjc:target
            append rel mjc:target = </go1/Physics/FR_hip_joint>
        }

