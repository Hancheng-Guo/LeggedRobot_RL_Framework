        </go1/Geometry/base/trunk/RR_hip/RR_thigh_rotor>,
        </go1/Geometry/base/trunk/RR_hip_rotor>,
        </go1/Geometry/base/trunk/RL_hip>,
        </go1/Geometry/base/trunk/RL_hip/RL_thigh>,
        </go1/Geometry/base/trunk/RL_hip/RL_thigh/RL_calf>,
        </go1/Geometry/base/trunk/RL_hip/RL_thigh/RL_calf/RL_foot>,
        </go1/Geometry/base/trunk/RL_hip/RL_thigh/RL_calf_rotor>,
        </go1/Geometry/base/trunk/RL_hip/RL_thigh_rotor>,
        </go1/Geometry/base/trunk/RL_hip_rotor>,
