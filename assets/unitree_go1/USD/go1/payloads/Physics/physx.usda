            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "FL_calf_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "RR_hip_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "RR_thigh_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
