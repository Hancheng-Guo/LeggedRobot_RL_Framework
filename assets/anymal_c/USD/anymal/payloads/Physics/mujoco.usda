        def MjcActuator "LF_HAA_actuator"
        {
            uniform double[] mjc:biasPrm = [0, -1.3962633609771729, -0.03490658476948738, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:biasType = "affine"
            uniform double mjc:forceRange:max = 80
            uniform double mjc:forceRange:min = -80
            uniform double[] mjc:gainPrm = [1.3962633609771729, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:gainType = "fixed"
            custom rel mjc:target
            append rel mjc:target = </anymal/Physics/LF_HAA>
        }

