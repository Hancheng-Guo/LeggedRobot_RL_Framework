#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "go1"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    upAxis = "Z"
)

over "go1" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    prepend rel isaac:physics:robotJoints = [
        </go1/Physics/floating_base>,
        </go1/Physics/imu_joint>,
        </go1/Physics/FR_hip_joint>,
        </go1/Physics/FR_hip_rotor_joint>,
        </go1/Physics/FL_hip_joint>,
        </go1/Physics/FL_hip_rotor_joint>,
        </go1/Physics/RR_hip_joint>,
        </go1/Physics/RR_hip_rotor_joint>,
        </go1/Physics/RL_hip_joint>,
        </go1/Physics/RL_hip_rotor_joint>,
        </go1/Physics/camera_joint_face>,
        </go1/Physics/camera_joint_chin>,
        </go1/Physics/camera_joint_left>,
        </go1/Physics/camera_joint_right>,
        </go1/Physics/camera_joint_rearDown>,
        </go1/Physics/ultraSound_joint_left>,
        </go1/Physics/ultraSound_joint_right>,
        </go1/Physics/ultraSound_joint_face>,
        </go1/Physics/FR_thigh_joint>,
        </go1/Physics/FR_thigh_rotor_joint>,
        </go1/Physics/FR_calf_joint>,
        </go1/Physics/FR_calf_rotor_joint>,
        </go1/Physics/FR_foot_fixed>,
        </go1/Physics/FL_thigh_joint>,
        </go1/Physics/FL_thigh_rotor_joint>,
        </go1/Physics/FL_calf_joint>,
        </go1/Physics/FL_calf_rotor_joint>,
        </go1/Physics/FL_foot_fixed>,
        </go1/Physics/RR_thigh_joint>,
        </go1/Physics/RR_thigh_rotor_joint>,
        </go1/Physics/RR_calf_joint>,
        </go1/Physics/RR_calf_rotor_joint>,
        </go1/Physics/RR_foot_fixed>,
        </go1/Physics/RL_thigh_joint>,
        </go1/Physics/RL_thigh_rotor_joint>,
        </go1/Physics/RL_calf_joint>,
        </go1/Physics/RL_calf_rotor_joint>,
        </go1/Physics/RL_foot_fixed>,
    ]
    prepend rel isaac:physics:robotLinks = [
        </go1/Geometry/base>,
        </go1/Geometry/base/trunk>,
        </go1/Geometry/base/trunk/imu_link>,
        </go1/Geometry/base/trunk/FR_hip>,
