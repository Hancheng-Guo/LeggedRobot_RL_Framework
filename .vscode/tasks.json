{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run: Main",
            "icon": { "id": "play" },
            "type": "process",
            "command": "${command:python.interpreterPath}",
            "args": [
                "${workspaceFolder}/main.py"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": true
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "windows": {
                "type": "shell",
                "command": "&",
                "args": [
                    "'${command:python.interpreterPath}'",
                    "'${workspaceFolder}/main.py'"
                ],
                "options": {
                    "cwd": "${workspaceFolder}",
                    "shell": {
                        "executable": "powershell.exe",
                        "args": [
                            "-NoProfile",
                            "-Command"
                        ]
                    }
                }
            }
        },
        {
            "label": "Tool: TensorBoard",
            "icon": { "id": "graph-line" },
            "type": "process",
            "command": "${command:python.interpreterPath}",
            "args": [
                "-m",
                "tools.launch_tensorboard",
                "${input:tensorboardLogdir}"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": true
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "windows": {
                "type": "shell",
                "command": "&",
                "args": [
                    "'${env:USERPROFILE}\\.conda\\envs\\quadruped_rl\\python.exe'",
                    "-m",
                    "tools.launch_tensorboard",
                    "'${input:tensorboardLogdir}'"
                ],
                "options": {
                    "cwd": "${workspaceFolder}",
                    "shell": {
                        "executable": "powershell.exe",
                        "args": ["-NoProfile", "-Command"]
                    }
                }
            }
        },
        {
            "label": "Tool: Play Checkpoint",
            "icon": { "id": "play-circle" },
            "type": "process",
            "command": "${command:python.interpreterPath}",
            "args": [
                "-m",
                "tools.play_checkpoint",
                "${input:playCheckpointDir}"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": true
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "windows": {
                "type": "shell",
                "command": "&",
                "args": [
                    "'${env:USERPROFILE}\\.conda\\envs\\quadruped_rl\\python.exe'",
                    "-m",
                    "tools.play_checkpoint",
                    "'${input:playCheckpointDir}'"
                ],
                "options": {
                    "cwd": "${workspaceFolder}",
                    "shell": {
                        "executable": "powershell.exe",
                        "args": ["-NoProfile", "-Command"]
                    }
                }
            }
        },
        {
            "label": "Check: MuJoCo",
            "icon": { "id": "checklist" },
            "group": "test",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Pyright: MuJoCo",
                "Pytest: MuJoCo"
            ],
            "problemMatcher": []
        },
        {
            "label": "Check: Isaac Sim",
            "icon": { "id": "checklist" },
            "group": "test",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Pyright: Isaac Sim",
                "Pytest: Isaac Sim"
            ],
            "problemMatcher": []
        },
        {
            "label": "Pytest: MuJoCo",
            "icon": { "id": "beaker" },
            "type": "process",
            "command": "'${command:python.interpreterPath}'",
            "args": [
                "-m",
                "pytest",
                "-m",
                "core or mujoco",
                "tests"
            ],
            "group": "test",
            "problemMatcher": [],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "windows": {
                "type": "shell",
                "command": "&",
                "args": [
                    "'${command:python.interpreterPath}'",
                    "-m",
                    "pytest",
                    "-m",
                    "core or mujoco",
                    "tests"
                ],
                "options": {
                    "cwd": "${workspaceFolder}",
                    "shell": {
                        "executable": "powershell.exe",
                        "args": [
                            "-NoProfile",
                            "-Command"
                        ]
                    }
                }
            }
        },
        {
            "label": "Pytest: Isaac Sim",
            "icon": { "id": "beaker" },
            "type": "process",
            "command": "'${command:python.interpreterPath}'",
            "args": [
                "-m",
                "pytest",
                "-m",
                "core or isaacsim",
                "tests"
            ],
            "group": "test",
            "problemMatcher": [],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "windows": {
                "type": "shell",
                "command": "&",
                "args": [
                    "'${command:python.interpreterPath}'",
                    "-m",
                    "pytest",
                    "-m",
                    "core or isaacsim",
                    "tests"
                ],
                "options": {
                    "cwd": "${workspaceFolder}",
                    "shell": {
                        "executable": "powershell.exe",
                        "args": [
                            "-NoProfile",
                            "-Command"
                        ]
                    }
                }
            }
        },
        {
            "label": "Pyright: MuJoCo",
            "icon": { "id": "inspect" },
            "type": "process",
            "command": "${command:python.interpreterPath}",
            "args": [
                "-m", "pyright",
                "--project", "pyrightconfig.mujoco.json",
                "--pythonpath", "${command:python.interpreterPath}"
            ],
            "group": "test",
            "problemMatcher": [],
            "options": { "cwd": "${workspaceFolder}" },
            "windows": {
                "type": "shell",
                "command": "&",
                "args": [
                    "'${command:python.interpreterPath}'",
                    "-m", "pyright",
                    "--project", "pyrightconfig.mujoco.json",
                    "--pythonpath", "'${command:python.interpreterPath}'"
                ],
                "options": {
                    "cwd": "${workspaceFolder}",
                    "shell": {
                        "executable": "powershell.exe",
                        "args": ["-NoProfile", "-Command"]
                    }
                }
            }
        },
        {
            "label": "Pyright: Isaac Sim",
            "icon": { "id": "inspect" },
            "type": "process",
            "command": "${command:python.interpreterPath}",
            "args": [
                "-m", "pyright",
                "--project", "pyrightconfig.isaac.json",
                "--pythonpath", "${command:python.interpreterPath}"
            ],
            "group": "test",
            "problemMatcher": [],
            "options": { "cwd": "${workspaceFolder}" },
            "windows": {
                "type": "shell",
                "command": "&",
                "args": [
                    "'${command:python.interpreterPath}'",
                    "-m", "pyright",
                    "--project", "pyrightconfig.isaac.json",
                    "--pythonpath", "'${command:python.interpreterPath}'"
                ],
                "options": {
                    "cwd": "${workspaceFolder}",
                    "shell": {
                        "executable": "powershell.exe",
                        "args": ["-NoProfile", "-Command"]
                    }
                }
            }
        }
    ],
    "inputs": [
        {
            "id": "tensorboardLogdir",
            "type": "promptString",
            "description": "运行目录名或 tensorboard 目录路径；留空选择日期最新的运行",
            "default": ""
        },
        {
            "id": "playCheckpointDir",
            "type": "promptString",
            "description": "运行目录名或路径；留空选择日期最新的运行",
            "default": ""
        }
    ]
}
