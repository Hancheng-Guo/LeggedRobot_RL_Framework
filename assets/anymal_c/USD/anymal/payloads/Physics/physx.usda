#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "anymal"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "anymal"
{
    over "Physics"
    {
        over "LF_HAA" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "LF_HFE" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "LF_KFE" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "RF_HAA" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "RF_HFE" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "RF_KFE" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "LH_HAA" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "LH_HFE" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "LH_KFE" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "RH_HAA" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "RH_HFE" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "RH_KFE" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }
    }
}

