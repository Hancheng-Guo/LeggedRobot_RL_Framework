        </go1/Geometry/base/trunk/FR_hip/FR_thigh_rotor>,
        </go1/Geometry/base/trunk/FR_hip_rotor>,
        </go1/Geometry/base/trunk/FL_hip>,
        </go1/Geometry/base/trunk/FL_hip/FL_thigh>,
        </go1/Geometry/base/trunk/FL_hip/FL_thigh/FL_calf>,
        </go1/Geometry/base/trunk/FL_hip/FL_thigh/FL_calf/FL_foot>,
        </go1/Geometry/base/trunk/FL_hip/FL_thigh/FL_calf_rotor>,
        </go1/Geometry/base/trunk/FL_hip/FL_thigh_rotor>,
        </go1/Geometry/base/trunk/FL_hip_rotor>,
        </go1/Geometry/base/trunk/RR_hip>,
        </go1/Geometry/base/trunk/RR_hip/RR_thigh>,
        </go1/Geometry/base/trunk/RR_hip/RR_thigh/RR_calf>,
        </go1/Geometry/base/trunk/RR_hip/RR_thigh/RR_calf/RR_foot>,
