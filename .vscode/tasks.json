{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run: Main",
            "icon": { "id": "play" },
            "type": "process",
            "command": "${command:python.interpreterPath}",
            "args": [
                "${workspaceFolder}/main.py"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": true
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "windows": {
                "type": "shell",
                "command": "&",
                "args": [
                    "'${command:python.interpreterPath}'",
                    "'${workspaceFolder}/main.py'"
                ],
                "options": {
                    "cwd": "${workspaceFolder}",
                    "shell": {
                        "executable": "powershell.exe",
                        "args": [
                            "-NoProfile",
                            "-Command"
                        ]
                    }
                }
            }
        },
        {
            "label": "Run: Select App",
            "icon": { "id": "play" },
            "type": "shell",
            "command": "&",
            "args": [
                "'${command:python.interpreterPath}'",
                "-m",
                "tools.run_app",
                "'${input:appConfigName}'"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": true
            },
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": {
                    "executable": "powershell.exe",
                    "args": ["-NoProfile", "-Command"]
                }
            }
        },
        {
            "label": "Tool: TensorBoard",
            "icon": { "id": "graph-line" },
            "type": "process",
            "command": "${command:python.interpreterPath}",
            "args": [
                "-m",
                "tools.launch_tensorboard",
                "${input:tensorboardLogdir}"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": true
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "windows": {
                "type": "shell",
                "command": "&",
                "args": [
                    "'${env:USERPROFILE}\\.conda\\envs\\quadruped_rl\\python.exe'",
                    "-m",
                    "tools.launch_tensorboard",
                    "'${input:tensorboardLogdir}'"
                ],
                "options": {
                    "cwd": "${workspaceFolder}",
                    "shell": {
                        "executable": "powershell.exe",
                        "args": ["-NoProfile", "-Command"]
                    }
                }
            }
        },
        {
            "label": "Tool: Play Checkpoint",
            "icon": { "id": "play-circle" },
            "type": "process",
            "command": "${command:python.interpreterPath}",
            "args": [
                "-m",
                "tools.play_checkpoint",
                "${input:playCheckpointDir}"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": true
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "windows": {
                "type": "shell",
                "command": "&",
                "args": [
                    "'${env:USERPROFILE}\\.conda\\envs\\quadruped_rl\\python.exe'",
                    "-m",
                    "tools.play_checkpoint",
                    "'${input:playCheckpointDir}'"
                ],
                "options": {
                    "cwd": "${workspaceFolder}",
                    "shell": {
                        "executable": "powershell.exe",
                        "args": ["-NoProfile", "-Command"]
                    }
                }
            }
        },
        {
            "label": "Check: MuJoCo",
            "icon": { "id": "checklist" },
            "group": "test",
            "type": "process",
            "command": "${command:python.interpreterPath}",
            "args": ["-m", "tools.run_checks", "mujoco"],
            "problemMatcher": [],
            "options": { "cwd": "${workspaceFolder}" },
            "windows": {
                "type": "shell",
                "command": "&",
                "args": [
                    "'${command:python.interpreterPath}'",
                    "-m", "tools.run_checks", "mujoco"
                ],
                "options": {
                    "cwd": "${workspaceFolder}",
                    "shell": {
                        "executable": "powershell.exe",
                        "args": ["-NoProfile", "-Command"]
                    }
                }
            }
        },
        {
            "label": "Check: Isaac Sim",
            "icon": { "id": "checklist" },
            "group": "test",
            "type": "process",
            "command": "${command:python.interpreterPath}",
            "args": ["-m", "tools.run_checks", "isaacsim"],
            "problemMatcher": [],
            "options": { "cwd": "${workspaceFolder}" },
            "windows": {
                "type": "shell",
                "command": "&",
                "args": [
                    "'${command:python.interpreterPath}'",
