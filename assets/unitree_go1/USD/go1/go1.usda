#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "go1"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    upAxis = "Z"
)

def Xform "go1" (
    prepend references = @./payloads/base.usda@
    variants = {
        string Physics = "physx"
    }
    append variantSets = "Physics"
)
{
    over "Geometry"
    {
        over "base" (
            prepend apiSchemas = ["PhysicsMassAPI"]
        )
        {
            float3 physics:diagonalInertia = (0.000001, 0.000001, 0.000001)
            float physics:mass = 0.001
            over "trunk"
            {
                def Xform "scan_rf"
                {
                    double3 xformOp:translate = (0.1, -0.085, -0.035)
                    quatf xformOp:orient = (0.17364818, 0.98480775, 0, 0)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]

                    def Cone "axis"
                    {
                        uniform token axis = "Z"
                        double height = 0.036
                        double radius = 0.009
                        color3f[] primvars:displayColor = [(0, 1, 1)]
                        uniform token purpose = "guide"
                    }
                }

                def Xform "scan_lf"
                {
                    double3 xformOp:translate = (0.1, 0.085, -0.035)
                    quatf xformOp:orient = (0.17364818, -0.98480775, 0, 0)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]

                    def Cone "axis"
                    {
                        uniform token axis = "Z"
                        double height = 0.036
                        double radius = 0.009
                        color3f[] primvars:displayColor = [(0, 1, 1)]
                        uniform token purpose = "guide"
                    }
                }

                def Xform "scan_rh"
                {
                    double3 xformOp:translate = (-0.1, -0.085, -0.035)
                    quatf xformOp:orient = (0.17364818, 0.98480775, 0, 0)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]

                    def Cone "axis"
                    {
                        uniform token axis = "Z"
                        double height = 0.036
                        double radius = 0.009
                        color3f[] primvars:displayColor = [(0, 1, 1)]
                        uniform token purpose = "guide"
                    }
                }

                def Xform "scan_lh"
                {
                    double3 xformOp:translate = (-0.1, 0.085, -0.035)
                    quatf xformOp:orient = (0.17364818, -0.98480775, 0, 0)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]

                    def Cone "axis"
                    {
                        uniform token axis = "Z"
                        double height = 0.036
                        double radius = 0.009
                        color3f[] primvars:displayColor = [(0, 1, 1)]
                        uniform token purpose = "guide"
                    }
                }
            }
        }
    }
    variantSet "Physics" = {
        "mujoco" (
            prepend payload = @./payloads/Physics/mujoco.usda@
        ) {

        }
        "none" {

        }
        "physics" (
            prepend payload = @./payloads/Physics/physics.usda@
        ) {

        }
        "physx" (
            prepend payload = @./payloads/Physics/physx.usda@
        ) {

        }
    }
}

