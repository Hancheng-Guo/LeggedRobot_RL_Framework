    "inputs": [
        {
            "id": "resumeRunDir",
            "type": "promptString",
            "description": "Training run name or path (blank: latest)",
            "default": ""
        },
        {
            "id": "resumeCheckpoint",
            "type": "promptString",
            "description": "Checkpoint within run (blank: automatic selection)",
            "default": ""
        },
        {
            "id": "resumeMode",
            "type": "pickString",
            "description": "Resume output: fork creates a new run; inplace writes to the original run",
            "options": ["fork", "inplace"],
            "default": "fork"
        },
        {
            "id": "appConfigName",
            "type": "command",
            "command": "extension.commandvariable.pickStringRemember",
            "args": {
                "description": "Select app",
                "key": "selectedAppName",
                "rememberTransformed": true,
                "options": [
                    {
                        "label": "Last: ${remember:selectedAppName}",
                        "value": "${remember:selectedAppName}"
                    },
                    {
                        "label": "Choose another...",
                        "value": "${pickFile:appConfig}"
                    }
                ],
                "remember": {
                    "selectedAppName": {
                        "key": "selectedAppName",
                        "default": "unitree_go1_mujoco_cpu_velocity_only"
                    }
                },
                "pickFile": {
                    "appConfig": {
                        "description": "Select config",
                        "fromFolder": { "fixed": "${workspaceFolder}/configs" },
                        "include": "*.yaml",
                        "display": "fileName",
                        "transform": { "text": "${fileBasenameNoExtension}" }
                    }
                }
            }
        },
        {
            "id": "tensorboardLogdir",
            "type": "promptString",
            "description": "Run name or log dir (blank: latest)",
            "default": ""
        },
        {
            "id": "playCheckpointDir",
            "type": "promptString",
            "description": "Run name or path (blank: latest)",
            "default": ""
        },
        {
            "id": "humanRos2PlaybackConfig",
            "type": "command",
            "command": "extension.commandvariable.pickStringRemember",
            "args": {
                "description": "Select human ROS 2 playback config",
                "key": "selectedHumanRos2Profile",
                "rememberTransformed": true,
                "options": [
                    {
                        "label": "Last: ${remember:selectedHumanRos2Profile}",
                        "value": "${remember:selectedHumanRos2Profile}"
                    },
                    {
                        "label": "Choose another...",
                        "value": "${pickFile:humanRos2PlaybackConfig}"
                    }
                ],
                "remember": {
                    "selectedHumanRos2Profile": {
                        "key": "selectedHumanRos2Profile",
                        "default": "locomotion_velocity"
                    }
                },
                "pickFile": {
                    "humanRos2PlaybackConfig": {
                        "description": "Select playback config",
                        "fromFolder": { "fixed": "${workspaceFolder}/configs/playback" },
                        "include": "*.yaml",
                        "display": "fileName",
                        "transform": { "text": "${fileBasenameNoExtension}" }
                    }
                }
            }
        }
    ]
}
