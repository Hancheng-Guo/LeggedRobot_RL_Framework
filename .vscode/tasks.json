                "options": {
                    "cwd": "${workspaceFolder}",
                    "shell": {
                        "executable": "powershell.exe",
                        "args": ["-NoProfile", "-Command"]
                    }
                }
            }
        },
        {
            "label": "Pytest: MuJoCo",
            "icon": { "id": "beaker" },
            "type": "process",
            "command": "'${command:python.interpreterPath}'",
            "args": [
                "-m",
                "pytest",
                "-m",
                "core or mujoco",
                "tests"
            ],
            "group": "test",
            "problemMatcher": [],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "windows": {
                "type": "shell",
                "command": "&",
                "args": [
                    "'${command:python.interpreterPath}'",
                    "-m",
                    "pytest",
                    "-m",
                    "core or mujoco",
                    "tests"
                ],
                "options": {
                    "cwd": "${workspaceFolder}",
                    "shell": {
                        "executable": "powershell.exe",
                        "args": [
                            "-NoProfile",
                            "-Command"
                        ]
                    }
                }
            }
        },
        {
            "label": "Pytest: Isaac Sim",
            "icon": { "id": "beaker" },
            "type": "process",
            "command": "'${command:python.interpreterPath}'",
            "args": [
                "-m",
                "pytest",
                "-m",
                "core or isaacsim",
                "tests"
            ],
            "group": "test",
            "problemMatcher": [],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "windows": {
                "type": "shell",
                "command": "&",
                "args": [
                    "'${command:python.interpreterPath}'",
                    "-m",
                    "pytest",
                    "-m",
                    "core or isaacsim",
                    "tests"
                ],
                "options": {
                    "cwd": "${workspaceFolder}",
                    "shell": {
                        "executable": "powershell.exe",
                        "args": [
                            "-NoProfile",
                            "-Command"
                        ]
                    }
                }
            }
        },
        {
            "label": "Pyright: MuJoCo",
            "icon": { "id": "inspect" },
            "type": "process",
            "command": "${command:python.interpreterPath}",
            "args": [
                "-m", "pyright",
                "--project", "pyrightconfig.mujoco.json",
                "--pythonpath", "${command:python.interpreterPath}"
            ],
            "group": "test",
            "problemMatcher": [],
            "options": { "cwd": "${workspaceFolder}" },
            "windows": {
                "type": "shell",
                "command": "&",
                "args": [
                    "'${command:python.interpreterPath}'",
                    "-m", "pyright",
                    "--project", "pyrightconfig.mujoco.json",
                    "--pythonpath", "'${command:python.interpreterPath}'"
                ],
                "options": {
                    "cwd": "${workspaceFolder}",
                    "shell": {
                        "executable": "powershell.exe",
                        "args": ["-NoProfile", "-Command"]
                    }
                }
            }
        },
        {
            "label": "Pyright: Isaac Sim",
            "icon": { "id": "inspect" },
            "type": "process",
            "command": "${command:python.interpreterPath}",
            "args": [
                "-m", "pyright",
                "--project", "pyrightconfig.isaac.json",
                "--pythonpath", "${command:python.interpreterPath}"
            ],
            "group": "test",
            "problemMatcher": [],
            "options": { "cwd": "${workspaceFolder}" },
            "windows": {
                "type": "shell",
                "command": "&",
                "args": [
                    "'${command:python.interpreterPath}'",
                    "-m", "pyright",
                    "--project", "pyrightconfig.isaac.json",
                    "--pythonpath", "'${command:python.interpreterPath}'"
                ],
                "options": {
                    "cwd": "${workspaceFolder}",
                    "shell": {
                        "executable": "powershell.exe",
                        "args": ["-NoProfile", "-Command"]
                    }
                }
            }
        }
    ],
    "inputs": [
        {
            "id": "appConfigName",
            "type": "command",
            "command": "extension.commandvariable.pickStringRemember",
            "args": {
                "description": "Select app",
                "key": "selectedAppName",
                "rememberTransformed": true,
                "options": [
                    {
                        "label": "Last: ${remember:selectedAppName}",
                        "value": "${remember:selectedAppName}"
                    },
                    {
                        "label": "Choose another...",
                        "value": "${pickFile:appConfig}"
                    }
                ],
                "remember": {
                    "selectedAppName": {
                        "key": "selectedAppName",
                        "default": "unitree_go1_mujoco_cpu_velocity_only"
                    }
                },
                "pickFile": {
                    "appConfig": {
                        "description": "Select config",
                        "fromFolder": { "fixed": "${workspaceFolder}/configs" },
                        "include": "*.yaml",
                        "display": "fileName",
                        "transform": { "text": "${fileBasenameNoExtension}" }
                    }
                }
            }
        },
        {
            "id": "tensorboardLogdir",
            "type": "promptString",
            "description": "Run name or log dir (blank: latest)",
            "default": ""
        },
        {
            "id": "playCheckpointDir",
            "type": "promptString",
            "description": "Run name or path (blank: latest)",
            "default": ""
        }
    ]
}
