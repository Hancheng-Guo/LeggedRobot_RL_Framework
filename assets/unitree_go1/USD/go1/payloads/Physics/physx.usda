#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "go1"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "go1"
{
    over "Physics"
    {
        over "FR_hip_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "FR_thigh_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "FR_calf_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

