        over "RL_hip_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "RL_thigh_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "RL_calf_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }
    }
}

